{
  "$schema": "https://schemastore.org/package.json",
  "name": "bookshelf-api",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "DinkyTrady"
  },
  "type": "module",
  "main": "./src/app.ts",
  "imports": {
    "#types/": "./src/types/",
    "#db/": "./src/db/",
    "#repository/": "./src/repository/",
    "#routes/": "./src/routes/",
    "#middleware/": "./src/middleware/",
    "#config/": "./src/config/",
    "#lib/": "./src/lib/",
    "#/": "./src/"
  },
  "scripts": {
    "dev": "bun run --smol --hot src/index.ts",
    "build": "bun build --target bun src/index.ts --outdir dist --minify",
    "start": "bun dist/index.js",
    "migrate": "bunx drizzle-kit generate && bunx drizzle-kit migrate",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "hono": "^4.13.14",
    "slugify": "^1.6.9",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
