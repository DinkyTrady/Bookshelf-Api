{
  "$schema": "https://schemastore.org/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": ["bun"],
    "paths": {
      "#/*": ["./src/*"],
      "./*": ["./*"]
    }
  },
  "exclude": ["node_modules"]
}
